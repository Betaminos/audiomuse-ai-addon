{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Berlin",

  // NOTE: gitAuthor is a self-hosted-only option and must NOT be set in this
  // file — Renovate would reject the config. It is set via the
  // RENOVATE_GIT_AUTHOR environment variable in the workflow instead.

  "customManagers": [
    // managerFilePatterns must be slash-wrapped to be treated as regex.
    // A plain string is parsed as a glob, where ^ and $ are literal
    // characters — matching nothing.
    {
      "customType": "regex",
      "description": "AudioMuse-AI release pin in the add-on Dockerfile",
      "managerFilePatterns": ["/^audiomuse-ai/Dockerfile$/"],
      "matchStrings": ["ARG AUDIOMUSE_VERSION=(?<currentValue>\\S+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "NeptuneHub/AudioMuse-AI",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "AudioMuse-AI upstream part of the add-on version (packaging suffix kept)",
      "managerFilePatterns": ["/^audiomuse-ai/config\\.json$/"],
      "matchStrings": ["\"version\":\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)-\\d+\""],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "NeptuneHub/AudioMuse-AI",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },

    // Maloja: Docker Hub tags are bare semver (upstream CI uses
    // metadata-action pattern={{version}}, e.g. krateng/maloja:3.2.7).
    {
      "customType": "regex",
      "description": "Maloja image tag pin in the add-on Dockerfile",
      "managerFilePatterns": ["/^maloja/Dockerfile$/"],
      "matchStrings": ["ARG MALOJA_VERSION=(?<currentValue>\\S+)"],
      "datasourceTemplate": "docker",
      "depNameTemplate": "krateng/maloja"
    },
    {
      "customType": "regex",
      "description": "Maloja upstream part of the add-on version (packaging suffix kept)",
      "managerFilePatterns": ["/^maloja/config\\.json$/"],
      "matchStrings": ["\"version\":\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)-\\d+\""],
      "datasourceTemplate": "docker",
      "depNameTemplate": "krateng/maloja"
    },
    // Rewind: upstream publishes only a `latest` Docker tag, so the image
    // is wrapped digest-pinned. Renovate opens a PR with the new digest
    // whenever :latest is republished; merging lets CI rebuild and bump
    // the packaging suffix.
    {
      "customType": "regex",
      "description": "Rewind image digest pin in the add-on Dockerfile",
      "fileMatch": ["^rewind/Dockerfile$"],
      "matchStrings": ["ARG REWIND_IMAGE=(?<depName>bernardogiordano/rewind):(?<currentValue>latest)@(?<currentDigest>sha256:[a-f0-9]{64})"],
      "autoReplaceStringTemplate": "ARG REWIND_IMAGE={{depName}}:{{currentValue}}@sha256:{{newDigest}}",
      "datasource": "docker"
    }
  ],

  "packageRules": [
    // Only propose clean semver tags for krateng/maloja — never "latest",
    // "edge", or other stray Docker Hub tags. The regex must be wrapped in
    // slashes for Renovate to treat it as a pattern.
    {
      "matchDatasources": ["docker"],
      "matchDepNames": ["krateng/maloja"],
      "allowedVersions": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },

    // The github-actions manager proposes updates to files under
    // .github/workflows. GitHub refuses workflow-file changes made with a
    // fine-grained PAT ("Workflows update rejection"), so those branches
    // always abort. Uncomment to silence that manager and bump workflow
    // actions manually instead:
    // {
    //   "matchManagers": ["github-actions"],
    //   "enabled": false
    // }

    // Optional, commented out: let patch/minor updates merge and publish
    // themselves. Remove the wrapping comment markers to go fully hands-off
    // (major version bumps will still wait for your review).
    // {
    //   "matchUpdateTypes": ["patch", "minor"],
    //   "automerge": true,
    //   "automergeType": "pr"
    // }
  ]
}
