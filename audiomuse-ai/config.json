{
  "name": "AudioMuse-AI",
  "version": "3.6.4-5",
  "slug": "audiomuse_ai",
  "description": "Sonic analysis, clustering and smart playlists for Navidrome (native aarch64 build with embedded PostgreSQL)",
  "arch": [
    "aarch64"
  ],
  "image": "ghcr.io/betaminos/hassio-addons/audiomuse-ai",
  "startup": "services",
  "boot": "auto",
  "hassio_api": false,
  "host_network": false,
  "ingress": false,
  "tmpfs": true,
  "panel_icon": "mdi:music-circle",
  "ports": {
    "8000/tcp": 8000
  },
  "ports_description": {
    "8000/tcp": "AudioMuse-AI web UI (Setup Wizard, analysis, playlists)"
  },
  "options": {},
  "schema": {},
  "environment": {
    "HOME": "/data",
    "AUDIOMUSE_OPEN_BROWSER": "0",
    "PYTHONUNBUFFERED": "1",
    "XDG_STATE_HOME": "/tmp/audiomuse-state"
  }
}
